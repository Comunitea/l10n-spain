<?xml version="1.0" encoding="utf-8" ?>
<odoo>
    <record model="res.groups.privilege" id="res_groups_privilege_aeat_mod180">
        <field name="name">AEAT Model 180</field>
        <field name="category_id" ref="base.module_category_hidden" />
    </record>
    <record id="group_aeat_mod180" model="res.groups">
        <field name="name">AEAT Model 180</field>
        <field name="privilege_id" ref="res_groups_privilege_aeat_mod180" />
        <field
            name="user_ids"
            eval="[Command.link(ref('base.user_root')), Command.link(ref('base.user_admin'))]"
        />
        <field
            name="implied_ids"
            eval="[Command.link(ref('l10n_es_aeat.group_account_aeat'))]"
        />
    </record>
    <record id="aeat_180_company_rule" model="ir.rule">
        <field name="name">AEAT 180 company</field>
        <field name="model_id" ref="model_l10n_es_aeat_mod180_report" />
        <field name="global" eval="True" />
        <field name="domain_force">[('company_id','in',company_ids)]</field>
    </record>
</odoo>
